/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",

    // 🔒 IMPORTANT: prevent @types/node from leaking into browser build
    "types": [],

    // ✅ Explicit browser libs only (fixes Symbol.dispose / Disposable errors)
    "lib": ["ES2020", "DOM"]
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts"
  ]
}
